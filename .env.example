# ==============================================================================
# Nivesh Firewall — Central Environment Configuration Template
# Phase 14.1: Production Configuration & Environment Architecture
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit .env or any file containing real secrets to version control.
# 2. Production credentials must come from secure deployment environment variables.
# 3. NIVESH_DEBUG must NEVER be enabled in production.
# 4. NIVESH_ALLOWED_ORIGINS in production must NEVER use wildcard '*'.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Mode
# ------------------------------------------------------------------------------
# Options: development, test, production
NIVESH_ENV=development

# Debug mode: True enables detailed local diagnostic logs.
# FORBIDDEN in production (startup validation will fail if True).
NIVESH_DEBUG=False

# Application metadata
NIVESH_APP_NAME="Nivesh Firewall"
NIVESH_VERSION="1.0.0"

# ------------------------------------------------------------------------------
# 2. Host & Network Binding
# ------------------------------------------------------------------------------
# Development: 127.0.0.1 or localhost
# Production: 0.0.0.0 or container network interface
NIVESH_HOST=127.0.0.1
NIVESH_PORT=8000

# ------------------------------------------------------------------------------
# 3. Security & Persistence Contract (Phase 14.1 contract for Phase 14.2)
# ------------------------------------------------------------------------------
# Secret key used for cryptographic signing, session hashing, and token verification
# Must be set to a high-entropy string in production.
NIVESH_SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Database Connection URI
# Development default: sqlite:///./nivesh_dev.db
# Test default:        sqlite:///:memory:
# Production REQUIRED: postgresql://<user>:<password>@<host>:5432/<dbname>
# Note: SQLite in-memory or fallback is strictly rejected by production validation.
NIVESH_DATABASE_URL=sqlite:///./nivesh_dev.db

# ------------------------------------------------------------------------------
# 4. Frontend & CORS Configuration
# ------------------------------------------------------------------------------
# Base URL where the primary Nivesh web application is hosted
NIVESH_FRONTEND_URL=http://localhost:5173

# Allowed CORS origins (JSON array or comma-separated list).
# In production: Wildcard '*' is strictly rejected by startup validation.
# Example: https://app.nivesh.ai,https://admin.nivesh.ai
NIVESH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Allowed Browser Extension IDs (chrome-extension://<id>)
# Example: abcdefghijklmnopabcdefghijklmnop
NIVESH_ALLOWED_EXTENSION_IDS=

# ------------------------------------------------------------------------------
# 5. Logging Configuration
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Development: DEBUG or INFO
# Test:        WARNING
# Production:  INFO or WARNING
# Note: Sensitive financial data (OTPs, PINs, cards, passwords) is automatically redacted.
NIVESH_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 6. Authoritative Source Intelligence (Engine 4)
# ------------------------------------------------------------------------------
# Mode: FIXTURE (safe offline deterministic), CACHE (cached registry entries), LIVE (real network lookups)
# Note: LIVE mode requires NIVESH_LIVE_SOURCES_ENABLED=True.
NIVESH_SOURCE_MODE=FIXTURE
NIVESH_LIVE_SOURCES_ENABLED=False

# ------------------------------------------------------------------------------
# 7. Operational Feature Flags
# ------------------------------------------------------------------------------
# Enable or disable browser extension content ingestion
NIVESH_FEATURE_BROWSER_EXTENSION=True

# Enable or disable prior analysis retrieval endpoint (/api/v1/firewall/analysis/{id})
NIVESH_FEATURE_ANALYSIS_RETRIEVAL=True

# ------------------------------------------------------------------------------
# 8. Network & Operation Timeouts
# ------------------------------------------------------------------------------
# API request timeout (seconds)
NIVESH_TIMEOUT_REQUEST_SECONDS=30.0

# Authoritative source retrieval timeout (seconds)
NIVESH_TIMEOUT_RETRIEVAL_SECONDS=10.0

# Pipeline execution timeout (milliseconds, optional)
# NIVESH_TIMEOUT_PIPELINE_MS=15000.0

# Per-engine timeout (milliseconds, optional)
# NIVESH_TIMEOUT_ENGINE_MS=5000.0

# ------------------------------------------------------------------------------
# 9. Maximum Payload Limits
# ------------------------------------------------------------------------------
# Maximum request body size (bytes, default 10MB)
NIVESH_MAX_REQUEST_BYTES=10485760

# Maximum text content length (characters, default 50,000)
NIVESH_MAX_CONTENT_LENGTH=50000

# Maximum URL length (characters, default 2048)
NIVESH_MAX_URL_LENGTH=2048

# Maximum image payload size (bytes, default 10MB)
NIVESH_MAX_IMAGE_BYTES=10485760

# Maximum session identifier length (characters, default 128)
NIVESH_MAX_SESSION_ID_LENGTH=128
