# ==============================================================================
# Nivesh Firewall — Production Deployment Environment Template
# Phase 14.5: Deployment, Performance & Production Validation
# ==============================================================================
# Copy this file to .env.production on deployment servers.
# Fill in real production secrets through secret managers (AWS Secrets Manager,
# HashiCorp Vault, Kubernetes Secrets, or GitHub Actions Secrets).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Mode (STRICT)
# ------------------------------------------------------------------------------
NIVESH_ENV=production
NIVESH_DEBUG=False
NIVESH_APP_NAME="Nivesh Firewall"
NIVESH_VERSION="1.0.0"

# ------------------------------------------------------------------------------
# 2. Host & Network Binding
# ------------------------------------------------------------------------------
NIVESH_HOST=0.0.0.0
NIVESH_PORT=8000
NIVESH_FORWARDED_ALLOW_IPS=*
NIVESH_WORKERS=4

# ------------------------------------------------------------------------------
# 3. Security, Persistence & Authentication Keys (REQUIRED)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
NIVESH_SECRET_KEY=generate_64_character_random_hex_string_for_production_secret_key

# PostgreSQL Persistent Database Connection URI
# REQUIRED: Must point to a production-grade PostgreSQL 15+ cluster.
# Format: postgresql://<user>:<password>@<host>:5432/<dbname>
NIVESH_DATABASE_URL=postgresql://nivesh_user:strong_production_db_password@postgres:5432/nivesh_db

# Static API Keys for Administrative and Internal Machine-to-Machine Operations
# Generate with: openssl rand -hex 24
NIVESH_ADMIN_API_KEY=generate_admin_key_for_compliance_officers
NIVESH_SERVICE_API_KEY=generate_service_key_for_internal_workers
NIVESH_AUTH_TOKEN_EXPIRE_SECONDS=3600

# Rate Limiting
NIVESH_RATE_LIMIT_ENABLED=True
NIVESH_RATE_LIMIT_REQUESTS_PER_MINUTE=120

# ------------------------------------------------------------------------------
# 4. Frontend & CORS Security
# ------------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated; wildcard '*' is strictly forbidden).
NIVESH_ALLOWED_ORIGINS=https://app.nivesh.ai,https://admin.nivesh.ai

# Allowed Chrome Extension IDs (comma-separated 32-character extension IDs).
NIVESH_ALLOWED_EXTENSION_IDS=

# ------------------------------------------------------------------------------
# 5. Logging & Observability
# ------------------------------------------------------------------------------
NIVESH_LOG_LEVEL=INFO
NIVESH_LOG_FORMAT=json
NIVESH_TRACING_ENABLED=True
NIVESH_METRICS_ENABLED=True
NIVESH_METRICS_PATH=/api/v1/metrics
NIVESH_HEALTH_DB_TIMEOUT_SECONDS=2.0

# ------------------------------------------------------------------------------
# 6. Authoritative Source Intelligence (Engine 4)
# ------------------------------------------------------------------------------
# Options: OFFICIAL_SNAPSHOT (recommended default), LIVE, FIXTURE
NIVESH_SOURCE_MODE=OFFICIAL_SNAPSHOT
NIVESH_LIVE_SOURCES_ENABLED=False

# Regulatory Exchange Credentials (for LIVE source mode)
NSE_API_KEY=
NSE_API_SECRET=
BSE_API_KEY=
BSE_API_SECRET=

# ------------------------------------------------------------------------------
# 7. Operational Feature Flags & Timeouts
# ------------------------------------------------------------------------------
NIVESH_FEATURE_BROWSER_EXTENSION=True
NIVESH_FEATURE_ANALYSIS_RETRIEVAL=True
NIVESH_TIMEOUT_REQUEST_SECONDS=30.0
NIVESH_TIMEOUT_RETRIEVAL_SECONDS=10.0

# ------------------------------------------------------------------------------
# 8. PostgreSQL Database Container Variables (for docker-compose)
# ------------------------------------------------------------------------------
POSTGRES_USER=nivesh_user
POSTGRES_PASSWORD=strong_production_db_password
POSTGRES_DB=nivesh_db
